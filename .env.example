# Create an API key at https://resend.com/api-keys.
RESEND_API_KEY=re_your_api_key

# Use different recipients in .env.local and the Vercel environment as needed.
RESEND_TO_EMAIL=example@gmail.com

# onboarding@resend.dev works for initial Resend testing. Replace this after
# verifying a sending domain if Resend requires it for the intended recipient.
RESEND_FROM_EMAIL="The Next Chapter <onboarding@resend.dev>"
